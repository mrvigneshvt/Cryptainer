{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cryptainer",
  "version": "0.1.0",
  "identifier": "com.cryptainer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cryptainer",
        "width": 1200,
        "height": 800,
        "minWidth": 375,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "scope": [
        "$APP",
        "$APP/*",
        "$APP/**/*",
        "$DOCUMENT",
        "$DOCUMENT/*",
        "$DOWNLOAD",
        "$DOWNLOAD/*"
      ]
    }
  }
}
